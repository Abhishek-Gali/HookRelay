# HookRelay Environment Configuration
# Generate strong 32+ byte secrets using:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Runtime Environment: development | test | production
# Note: 'production' enforces >=16 char GITHUB_WEBHOOK_SECRET and >=32 char API keys,
# and rejects any known placeholder/default credentials at startup.
ENVIRONMENT=development

# GitHub Secret configured in your GitHub repo webhook settings
GITHUB_WEBHOOK_SECRET=replace_with_32_byte_random_webhook_secret

# Management API Authentication & RBAC Keys (Required in production, >=32 chars)
ADMIN_API_KEY=replace_with_32_byte_random_admin_api_key_here
OPERATOR_API_KEY=replace_with_32_byte_random_operator_api_key_here
VIEWER_API_KEY=replace_with_32_byte_random_viewer_api_key_here

# Downstream Notification Targets
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/replace_with_token
SLACK_WEBHOOK_URL=

# Database URL (Durable Job Queue + Idempotency Store)
# Local development default:
DATABASE_URL=sqlite+aiosqlite:///./hookrelay.db
# Production PostgreSQL / Supabase example:
# DATABASE_URL=postgresql+asyncpg://user:password@db.example.com:5432/hookrelay

# Rate Limiting & DoS Protection
MAX_PAYLOAD_BYTES=5242880
MAX_ERROR_BODY_BYTES=2048
RATE_LIMIT_REQUESTS_PER_MINUTE=300
API_RATE_LIMIT_PER_MINUTE=60
REDRIVE_RATE_LIMIT_PER_MINUTE=10
AUTH_FAILURE_LIMIT_PER_MINUTE=10

# Retries, Worker Leases & Reconciliation
MAX_RETRIES=5
MAX_RETRY_AFTER_SECONDS=60.0
REQUEST_TIMEOUT_SECONDS=10.0
WORKER_LEASE_SECONDS=120
RECONCILIATION_BATCH_SIZE=100
RECONCILIATION_INTERVAL_SECONDS=60
STALE_THRESHOLD_SECONDS=120

# Features & Access Control
ENABLE_EMBEDS=true
ENABLE_RECONCILIATION=true
REQUIRE_METRICS_AUTH=false
ALLOW_PRIVATE_DESTINATIONS=false
