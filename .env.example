# HookRelay Environment Variables

# GitHub Secret configured in your GitHub repo webhook settings
GITHUB_WEBHOOK_SECRET=my_super_secret_github_webhook_token_123

# Discord Incoming Webhook URL (create this in Discord Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789/abcdefghijklmnopqrstuvwxyz

# Database URL
# Local development default:
DATABASE_URL=sqlite+aiosqlite:///./hookrelay.db
# Production Supabase / PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres:password@db.supabase.co:5432/postgres

# Performance & Security
MAX_PAYLOAD_BYTES=5242880
MAX_RETRIES=5
REQUEST_TIMEOUT_SECONDS=10.0

# Features
ENABLE_EMBEDS=true
ENABLE_RECONCILIATION=true
RECONCILIATION_INTERVAL_SECONDS=60
STALE_THRESHOLD_SECONDS=120
ENVIRONMENT=development
